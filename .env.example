# 1. DATABASE
DATABASE_URL=

# 2. APP URLS
NEXT_PUBLIC_URL="https://www.usa.truekinspection.com/"
NEXT_PUBLIC_APP_URL="https://www.usa.truekinspection.com/"

# 3. EMAIL (RESEND)
RESEND_API_KEY=
# Ops inbox for payment/report notifications (defaults to truekinspection@gmail.com)
OWNER_EMAIL=truekinspection@gmail.com
RESEND_EMAIL=

# 4. Polar API credentials
# POLAR_SERVER=sandbox|production (optional; defaults: non-production NODE_ENV → sandbox)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
NEXT_PUBLIC_POLAR_ORGANIZATION=
# Slug of the VIN custom field created in Polar dashboard (Settings → Custom Fields)
# Must also be attached to the product under Checkout Fields.
POLAR_VIN_CUSTOM_FIELD_SLUG=vin

# 5. CLEARVIN API (v2.0 vendor REST)
# Environment switch:
#   CLEARVIN_ENV=test|production  (optional; defaults from NODE_ENV)
# Test / staging: static Bearer token — no login. Only approved test VINs work.
# Production: email/password login → JWT (120m), auto-refresh before expiry.
CLEARVIN_ENV=
CLEARVIN_TEST_TOKEN=
CLEARVIN_EMAIL=
CLEARVIN_PASSWORD=
